# Git LFS tracking for large model files
# If your models/aqi_model.pkl exceeds GitHub's 100MB limit, enable Git LFS:
#   git lfs install
#   git lfs track 'models/*.pkl'
# Then uncomment the line below:
# models/*.pkl filter=lfs diff=lfs merge=lfs -text

# Standard line endings
* text=auto
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
