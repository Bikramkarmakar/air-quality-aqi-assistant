# Air Quality AQI Assistant — Environment Variables
# ---------------------------------------------------
# Copy this file to .env and fill in your real API keys.
# NEVER commit the .env file to GitHub or share it publicly.
#
# WAQI key  -> https://aqicn.org/api/          (free)
# Gemini key -> https://aistudio.google.com/app/apikey  (free)

AQI_API_KEY=your_waqi_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
